---
import Base from '../layouts/Base.astro';
import { getVolunteerSignups, orgTag } from '../lib/sanity';

/* Sign-ups are edited in the Studio. A row with no link renders as "coming
   soon" rather than a dead button, which is the normal state — these go up
   before the sheet exists more often than not. */
const signups = await getVolunteerSignups();
---

<Base title="Volunteer">
  <section>
    <div class="wrap">
      <div class="sec-head page-head">
        <div>
          <p class="eyebrow">Volunteer</p>
          <h2>We need your help</h2>
          <p>Two ways to pitch in: help steer the Foundation, or help run the events with PAC.</p>
        </div>
      </div>
      <h3 class="block-title">Current sign-ups</h3>
      <p class="block-lede">Open right now. The general volunteer survey covers everything else &mdash;
         fill it in once and we&rsquo;ll reach out when something fits.</p>
      <div class="signups-card">
        <ul class="signup-list">
          {signups.map((s) => {
            const tag = orgTag(s.org);
            return (
              <li class={`signup-row${s.url ? ' is-live' : ''}`}>
                <span class={`owner ${tag.cls}`}>{tag.label}</span>
                <div class="signup-body">
                  <div class="signup-name">{s.title}</div>
                  {s.description && <div class="signup-desc">{s.description}</div>}
                </div>
                <span class="signup-when">{s.url ? 'Sign up now' : s.when}</span>
                {s.url ? (
                  <a class="signup-cta" href={s.url} target="_blank" rel="noopener noreferrer">Sign up &rarr;</a>
                ) : (
                  <span class="signup-status">Sign-up sheet coming soon</span>
                )}
              </li>
            );
          })}
        </ul>
        <div class="open-cta">
          <a class="btn btn-primary"
             href="https://docs.google.com/forms/d/e/1FAIpQLSd2Xfb71mhhmQT17agD5XBAe8FrWBOS_ID1nHIZodFvdQkfvw/viewform"
             target="_blank" rel="noopener noreferrer">Fill in the volunteer survey &rarr;</a>
        </div>
      </div>

      <div class="duo">
        <div class="duo-side foundation">
          <div class="duo-org">Foundation</div>
          <h3>Join the board</h3>
          <p>Elected roles that steer fundraising and decide how the money is spent. Board
             members attend the monthly meeting.</p>
          <div class="duo-label">Open for 26&ndash;27:</div>
          <ul class="duo-list vol-list">
<li>President</li>
            <li>Vice President</li>
            <li>Co-Treasurer</li>
            <li>Red Envelope Co-Chair</li>
            <li>Corporate Sponsorship</li>
          </ul>
          <a class="btn btn-onphoto panel-btn" href="/contact/?to=sponsorship" >Contact the Foundation</a>
        </div>
        <div class="duo-side pac">
          <div class="duo-org">PAC</div>
          <h3>Help run an event</h3>
          <p>Chairs and helpers for the events that make the school year. Most take a few hours
             around a single event.</p>
          <div class="duo-label">Ways to help:</div>
          <ul class="duo-list vol-list two-up">
<li>Book Fair</li>
            <li>Carnival</li>
            <li>Dances</li>
            <li>Dine Outs</li>
            <li>Family Nights</li>
            <li>Giving Tree</li>
            <li>Hospitality</li>
            <li>Multicultural Night</li>
            <li>Parent Coffee</li>
            <li>Picture Day</li>
            <li>Room Parents</li>
            <li>School Beautification</li>
            <li>Senior Clap Out</li>
            <li>Spirit Wear</li>
            <li>Talent Show</li>
            <li>Yearbook</li>
          </ul>
          <a class="btn btn-onphoto panel-btn" href="/contact/?to=pac" >Contact PAC</a>
        </div>
      </div>
    </div>
  </section>
</Base>
