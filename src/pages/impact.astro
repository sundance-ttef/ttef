---
import Base from '../layouts/Base.astro';
import DevNote from '../components/DevNote.astro';
---

<Base title="Our Impact">
  <!-- IMPACT -->
  <section class="impact" id="impact-section">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Our impact</p>
          <h2>What We Fund</h2>
          <p>We currently fund or partially fund four Sundance staff positions.</p>
        </div>
      </div>

      <div class="staff">
        <div class="staff-card">
          <div class="role">Physical Education</div>
          <div class="name">Mrs. Norris</div>
        </div>
        <div class="staff-card">
          <div class="role">Music &amp; Choir</div>
          <div class="name">Mrs. Serrano</div>
        </div>
        <div class="staff-card">
          <div class="role">Math &amp; STEAM Aide</div>
          <div class="name">Mrs. Miles</div>
        </div>
        <div class="staff-card">
          <div class="role">School Counselor</div>
          <div class="name">Ms. Parks</div>
        </div>
      </div>

      <div class="also-fund">
        <h3>Additional items we cover</h3>
        <ul>
          <li>Science lab</li>
          <li>Music program, choir, music classes, and grade level performances</li>
          <li>Impact reading program</li>
          <li>Educational software subscriptions</li>
          <li>Additional supplies for classrooms</li>
        </ul>
      </div>

      <div class="funding">
        <div class="breakdown">
          <h3>Full line&#8209;item breakdown</h3>
          <ul class="fund-list">
            <li><span>Math + STEAM Impact Aide <em>(Mrs. Miles)</em></span><span class="amt">$29,645</span></li>
            <li><span>Reading Impact Aide</span><span class="amt">$19,634</span></li>
            <li><span>Fundraising Support <em>(Red Envelope, Fun Run, Auction)</em></span><span class="amt">$16,500</span></li>
            <li><span>PE Teacher <em>(Mrs. Norris)</em></span><span class="amt">$15,815</span></li>
            <li><span>School, Classroom + Library Supplies</span><span class="amt">$11,500</span></li>
            <li><span>Music + Choir Teacher <em>(Mrs. Serrano)</em></span><span class="amt">$6,800</span></li>
            <li><span>Field Trip Support</span><span class="amt">$4,900</span></li>
            <li><span>Clubs &mdash; Running, Chess, Musical Theater + more</span><span class="amt">$3,100</span></li>
            <li><span>Business Expenses <em>(insurance, taxes, website)</em></span><span class="amt">$2,050</span></li>
            <li><span>PAC Support &amp; Student Activities</span><span class="amt">$2,000</span></li>
          </ul>
          <div class="fund-total"><span>2026&ndash;27 goal</span><span class="num">$111,944</span></div>
        </div>

        <aside class="goal-card">
          <p class="eyebrow">Raised so far</p>
          <div class="goal-figure">$38,420</div>
          <div class="goal-of">of our <span class="num">$111,944</span> goal for 2026&ndash;27</div>
          <div class="bar"><div class="bar-fill"></div></div>
          <div class="bar-legend"><span>34% funded</span><span>Updated Aug 11</span></div>
          <DevNote><b>Sample figure.</b> This bar needs one real number and a
             named owner before launch &mdash; the current site&rsquo;s meter reads $0, which reads
             worse than showing nothing at all.</DevNote>
        </aside>
      </div>
    </div>
  </section>
</Base>
