---
import Base from '../layouts/Base.astro';
import { fundraising, budget, goalText, raisedText, percent } from '../data/fundraising';

const usd = (n: number) => '$' + n.toLocaleString('en-US');

/* The things funded beyond the four staff positions. These were a bulleted
   list in a white box — the flattest block on a page whose whole job is to
   show what the money does. They are cards now, in the same language as the
   staff above, because they are the same kind of fact.

   Maroon, NOT teal: on this site teal means PAC, and colouring these teal
   would say the PAC funds them when the Foundation does. */
const alsoFund = [
  {icon: '\u{1F52C}', name: 'Science lab', note: 'Hands-on science for every grade.'},
  {icon: '\u{1F3B5}', name: 'Music, choir & performances', note: 'Classes, choir, and grade-level shows.'},
  {icon: '\u{1F4D6}', name: 'Impact reading program', note: 'Targeted support for readers who need it.'},
  {icon: '\u{1F4BB}', name: 'Educational software', note: 'The subscriptions classrooms use daily.'},
  {icon: '\u{270F}\u{FE0F}', name: 'Classroom supplies', note: 'The extras teachers would otherwise buy themselves.'},
];
---

<Base title="Our Impact">
  <!-- IMPACT -->
  <section class="impact" id="impact-section">
    <div class="wrap">
      <div class="sec-head page-head">
        <div>
          <p class="eyebrow">Our impact</p>
          <h2>What we fund</h2>
          <p>We currently fund or partially fund four Sundance staff positions.</p>
        </div>
      </div>

      <div class="staff">
        <div class="staff-card">
          <div class="role">Physical Education</div>
          <div class="name">Mrs. Norris</div>
        </div>
        <div class="staff-card">
          <div class="role">Music &amp; Choir</div>
          <div class="name">Mrs. Serrano</div>
        </div>
        <div class="staff-card">
          <div class="role">Math &amp; STEAM Aide</div>
          <div class="name">Mrs. Miles</div>
        </div>
        <div class="staff-card">
          <div class="role">School Counselor</div>
          <div class="name">Ms. Parks</div>
        </div>
      </div>

      <h3 class="block-title spaced">Additional items we cover</h3>
      <div class="also-grid">
        {alsoFund.map((item) => (
          <div class="also-card">
            <div class="also-icon" aria-hidden="true">{item.icon}</div>
            <div class="also-name">{item.name}</div>
            <p>{item.note}</p>
          </div>
        ))}
      </div>

      <div class="funding">
        <div class="breakdown">
          <h3>Full line&#8209;item breakdown</h3>
          <ul class="fund-list">
            {budget.map((line) => (
              <li>
                <span>{line.label}{line.note && <> <em>({line.note})</em></>}</span>
                <span class="amt">{usd(line.amount)}</span>
              </li>
            ))}
          </ul>
          <div class="fund-total"><span>{fundraising.schoolYear} goal</span><span class="num">{goalText}</span></div>
        </div>

        <aside class="goal-card">
          <p class="eyebrow">Raised so far</p>
          <div class="goal-figure">{raisedText}</div>
          <div class="goal-of">of our <span class="num">{goalText}</span> goal for {fundraising.schoolYear}</div>
          <div class="bar"><div class="bar-fill" style={`width:${percent}%`}></div></div>
          <div class="bar-legend"><span>{percent}% funded</span>{fundraising.updated && <span>Updated {fundraising.updated}</span>}</div>
        </aside>
      </div>
    </div>
  </section>
</Base>
