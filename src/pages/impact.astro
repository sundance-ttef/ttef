---
import Base from '../layouts/Base.astro';
import { fundraising, budget, goalText, raisedText, percent } from '../data/fundraising';

const usd = (n: number) => '$' + n.toLocaleString('en-US');
---

<Base title="Our Impact">
  <!-- IMPACT -->
  <section class="impact" id="impact-section">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Our impact</p>
          <h2>What We Fund</h2>
          <p>We currently fund or partially fund four Sundance staff positions.</p>
        </div>
      </div>

      <div class="staff">
        <div class="staff-card">
          <div class="role">Physical Education</div>
          <div class="name">Mrs. Norris</div>
        </div>
        <div class="staff-card">
          <div class="role">Music &amp; Choir</div>
          <div class="name">Mrs. Serrano</div>
        </div>
        <div class="staff-card">
          <div class="role">Math &amp; STEAM Aide</div>
          <div class="name">Mrs. Miles</div>
        </div>
        <div class="staff-card">
          <div class="role">School Counselor</div>
          <div class="name">Ms. Parks</div>
        </div>
      </div>

      <div class="also-fund">
        <h3>Additional items we cover</h3>
        <ul>
          <li>Science lab</li>
          <li>Music program, choir, music classes, and grade level performances</li>
          <li>Impact reading program</li>
          <li>Educational software subscriptions</li>
          <li>Additional supplies for classrooms</li>
        </ul>
      </div>

      <div class="funding">
        <div class="breakdown">
          <h3>Full line&#8209;item breakdown</h3>
          <ul class="fund-list">
            {budget.map((line) => (
              <li>
                <span>{line.label}{line.note && <> <em>({line.note})</em></>}</span>
                <span class="amt">{usd(line.amount)}</span>
              </li>
            ))}
          </ul>
          <div class="fund-total"><span>{fundraising.schoolYear} goal</span><span class="num">{goalText}</span></div>
        </div>

        <aside class="goal-card">
          <p class="eyebrow">Raised so far</p>
          <div class="goal-figure">{raisedText}</div>
          <div class="goal-of">of our <span class="num">{goalText}</span> goal for {fundraising.schoolYear}</div>
          <div class="bar"><div class="bar-fill" style={`width:${percent}%`}></div></div>
          <div class="bar-legend"><span>{percent}% funded</span>{fundraising.updated && <span>Updated {fundraising.updated}</span>}</div>
        </aside>
      </div>
    </div>
  </section>
</Base>
