---
import Base from '../../layouts/Base.astro';
---

<Base title="Spring Auction">
  <section>
    <div class="wrap">
      <div class="sec-head page-head">
        <div>
          <p class="eyebrow">Support us</p>
          <h2>Spring Auction</h2>
          <p>An evening out for the grown-ups, and one of the biggest nights of the Foundation&rsquo;s year.</p>
        </div>
      </div>
      <div class="stat-row">
        <div class="stat"><div class="stat-num num">$10,500+</div><div class="stat-label">Raised in 2024</div></div>
        <div class="stat"><div class="stat-num">Feb 26</div><div class="stat-label">2027 auction</div></div>
        <div class="stat"><div class="stat-num">5:30 PM</div><div class="stat-label">Doors open</div></div>
      </div>
      <div class="gallery">
        <div class="gal-item"><span>Photo needed</span></div>
        <div class="gal-item"><span>Photo needed</span></div>
        <div class="gal-item"><span>Photo needed</span></div>
        <div class="gal-item"><span>Photo needed</span></div>
      </div>
      <div class="breakdown mt">
        <h3>Donate an item</h3>
        <p class="col-p">Local businesses and families donate the items that make the night work &mdash;
           experiences, gift certificates, services, and class projects. If you have something to
           offer, we&rsquo;d love to hear from you.</p>
        <a class="btn btn-primary" href="/contact/" data-contact="foundation">Offer an item</a>
      </div>
    </div>
  </section>
</Base>
