---
import Base from '../../layouts/Base.astro';
import { giving } from '../../data/giving';
import { askText } from '../../data/fundraising';
---

<Base title="Red Envelope Campaign">
  <section>
    <div class="wrap">
      <div class="sec-head page-head">
        <div>
          <p class="eyebrow">Support us</p>
          <h2>Red Envelope Campaign</h2>
          <p>Our biggest fundraiser of the year. One ask that supports both the Foundation and PAC for the entire school year.</p>
        </div>
      </div>
      <div class="two-col two-col--fit">
        <div class="breakdown">
          <h3>How it works</h3>
          <p class="col-p">A red envelope comes home with your Wildcat. Fill in the slip, choose how
             you&rsquo;d like to give, and send it back &mdash; that&rsquo;s it. <b>100% of your donation
             goes to ensuring the best education possible for our Wildcats.</b></p>
          <p class="col-p">We ask for <b>{askText} per student</b>, which is our total goal divided evenly
             across the school. It is only a suggestion &mdash; every gift, of any size, matters. If
             {askText} is a stretch, ask us about monthly payments or give your time instead.</p>
          <p class="col-p">Every student who contributes any amount gets an exclusive Sundance
             sticker and a raffle ticket for the Sundance prize basket.</p>
          <h3 class="mt">Ways to give</h3>
          <ul class="fund-list">
            <li><span>Online donation form</span><span class="amt">JotForm</span></li>
            <li><span>Credit card</span><span class="amt">Square</span></li>
            <li><span>PayPal &mdash; one time</span><span class="amt">PayPal</span></li>
            <li><span>PayPal &mdash; 10 monthly payments</span><span class="amt">$10&ndash;$50/mo</span></li>
            <li><span>Check, payable to Twin Trails Education Foundation</span><span class="amt">By mail</span></li>
            <li><span>Cash, in the red envelope</span><span class="amt">To school</span></li>
          </ul>
          <div class="btn-row">
            <a class="btn btn-primary" href="/donate/">Donate now</a>
            <a class="btn btn-outline" href="/donate/">Set up monthly giving</a>
          </div>
        </div>
        <aside class="match-card">
          <div class="match-icon">&#10005;&#65038;2</div>
          <h3>Double your gift</h3>
          <p>Many employers match charitable donations &mdash; some at 2:1. It is usually a short
             online form, and it can double what Sundance receives at no extra cost to you.</p>
          <a class="btn btn-gold" href={giving.matchingGifts} target="_blank" rel="noopener noreferrer">Check your employer</a>
          <p class="match-note">Questions about matching? Gautham Jayaram handles them.</p>
        </aside>
      </div>
    </div>
  </section>
</Base>
