---
import Base from '../../layouts/Base.astro';
---

<Base title="Support Us" darkTop>
  <!-- SUPPORT US -->
  <section class="give-band" id="give">
    <div class="wrap">
      <div class="give-inner">
        <p class="eyebrow give-eyebrow">Support us</p>
        <h2>Every penny goes straight to the classroom</h2>
        <p class="give-lead">Our suggested contribution is <b>$250 per student</b> &mdash; the
           lowest ask of any comparable school in Poway Unified. Give any amount, once or
           monthly, and your employer may double it.</p>
        <div class="give-actions">
          <a class="btn btn-lg btn-onphoto" href="/donate/">Donate now</a>
          <a class="btn btn-lg btn-ghost-light" href="/donate/">Set up monthly giving</a>
        </div>
      </div>

      <div class="progress-wide on-dark">
        <div class="pw-head">
          <div>
            <p class="eyebrow">2026&ndash;27 progress</p>
            <div class="pw-figure"><span class="num">$38,420</span> <span class="pw-of">of <span class="num">$111,944</span></span></div>
          </div>
          <div class="pw-pct num">34%</div>
        </div>
        <div class="bar bar-lg"><div class="bar-fill"></div></div>
        <div class="bar-legend"><span>Updated Aug 11</span><span class="num">$73,524 to go</span></div>
      </div>

      <div class="fundraisers">
        <a class="fr" href="/support/red-envelope/">
          <span class="when">Sep &ndash; Nov</span>
          <h3>Red Envelope</h3>
          <p>Our biggest fundraiser of the year. One ask that supports both the Foundation and
             PAC for the full year.</p>
        </a>
        <a class="fr" href="/support/auction/">
          <span class="when">February</span>
          <h3>Spring Auction</h3>
          <p>An evening out for the grown-ups. The 2024 auction raised more than $10,500 for
             Sundance students.</p>
        </a>
        <a class="fr" href="/support/fun-run/">
          <span class="when">March</span>
          <h3>Fun Run</h3>
          <p>Students collect pledges and run their hearts out. School-wide goals unlock
             all-school celebrations.</p>
        </a>
        <a class="fr" href="/support/dine-out/">
          <span class="when">Monthly</span>
          <h3>Dine Out Nights</h3>
          <p>Eat at a local restaurant on the right night and a portion of your check comes
             back to Sundance.</p>
        </a>
      </div>


      <p class="give-fine">Twin Trails Education Foundation is a 501(c)(3). Every donation is
         tax&#8209;deductible. Federal Tax ID 20&#8209;1105904. Ask your employer about matching
         gifts at matchinggifts.com/powayusd.</p>
    </div>
  </section>


  <section class="spiritwear">
    <div class="wrap">
      <div class="teaser-inner">
        <div>
          <p class="eyebrow">PAC &middot; Spirit Wear</p>
          <h2>Wear the Wildcat</h2>
          <p>Sundance shirts, hoodies, and spirit gear. Every purchase supports PAC events
             and activities throughout the year.</p>
        </div>
        <a class="btn btn-lg btn-primary" href="/shop/">Shop Spirit Wear</a>
      </div>
    </div>
  </section>

  <!-- SPONSORS -->
  <section class="sponsors" id="sponsors">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Thank you</p>
          <h2>Our corporate sponsors</h2>
          <p>Local businesses who fund Sundance directly. Sponsorships start at $250.</p>
        </div>
        <a class="btn btn-gold" href="/support/">Become a sponsor</a>
      </div>
      <div class="tier-row">
        <div class="tier platinum">
          <div class="tier-head"><span class="tier-name">Platinum</span><span class="tier-rule"></span></div>
          <div class="marquee"><div class="marquee-track">
            <a href="https://thebarronteam.com" target="_blank" rel="noopener noreferrer"><img src="/img/sp-barron.png" alt="The Barron Team"></a>
          </div></div>
        </div>
        <div class="tier gold">
          <div class="tier-head"><span class="tier-name">Gold</span><span class="tier-rule"></span></div>
          <div class="marquee"><div class="marquee-track">
            <a href="https://www.drmelanieorthodontics.com/" target="_blank" rel="noopener noreferrer"><img src="/img/sp-dmo.png" alt="Dr. Melanie Orthodontics"></a>
            <a href="https://smilephr.com" target="_blank" rel="noopener noreferrer"><img src="/img/sp-smilephr.png" alt="Smile PHR"></a>
            <a href="https://www.carmelmtndentalcare.com/" target="_blank" rel="noopener noreferrer"><img src="/img/sp-cmdc.png" alt="Carmel Mountain Dental Care"></a>
          </div></div>
        </div>
        <div class="tier silver">
          <div class="tier-head"><span class="tier-name">Silver</span><span class="tier-rule"></span></div>
          <div class="marquee"><div class="marquee-track">
            <a href="https://kappelrealtygroup.com" target="_blank" rel="noopener noreferrer"><img src="/img/sp-kappel.png" alt="Kappel Realty Group"></a>
          </div></div>
        </div>
      </div>
    </div>
  </section>

  <section class="sponsor-program" id="sponsorship">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Corporate sponsorship</p>
          <h2>Choose your level</h2>
          <p>Sponsorships run the full school year and start at $250. Every level puts your
             business in front of 415 Sundance families.</p>
        </div>
        <a class="btn btn-lg btn-gold" href="/contact/" data-contact="foundation">Become a sponsor</a>
      </div>

      <div class="tier-table-wrap">
        <table class="tier-table">
          <caption class="sr">Corporate sponsorship benefits by level</caption>
          <thead>
            <tr>
              <th scope="col" class="benefit-col">Sponsorship opportunities</th>
            <th scope="col"><span class="tier-h">Platinum</span><span class="tier-p num">$1,600</span></th>
            <th scope="col"><span class="tier-h">Gold</span><span class="tier-p num">$1,000</span></th>
            <th scope="col"><span class="tier-h">Silver</span><span class="tier-p num">$500</span></th>
            <th scope="col"><span class="tier-h">Bronze</span><span class="tier-p num">$250</span></th>
            </tr>
          </thead>
          <tbody>
          <tr class="grp"><th scope="colgroup" colspan="5">Fundraising Events</th></tr>
          <tr><th scope="row">2 tickets to the Sundance Auction with &ldquo;front of line&rdquo; access, plus a meet &amp; greet with school administration</th><td class="yes"><span aria-hidden="true">&#10003;</span><span class="sr">Included</span></td><td class="yes"><span aria-hidden="true">&#10003;</span><span class="sr">Included</span></td><td class="yes"><span aria-hidden="true">&#10003;</span><span class="sr">Included</span></td><td class="yes"><span aria-hidden="true">&#10003;</span><span class="sr">Included</span></td></tr>
          <tr><th scope="row">Fun Run &mdash; your logo on the T-shirt worn by all students &amp; staff</th><td class="yes"><span aria-hidden="true">&#10003;</span><span class="sr">Included</span></td><td class="no"><span aria-hidden="true">&middot;</span><span class="sr">Not included</span></td><td class="no"><span aria-hidden="true">&middot;</span><span class="sr">Not included</span></td><td class="no"><span aria-hidden="true">&middot;</span><span class="sr">Not included</span></td></tr>
          <tr class="grp"><th scope="colgroup" colspan="5">Website + Social Media</th></tr>
          <tr><th scope="row">Logo + recognition on TwinTrailsFoundation.org</th><td class="yes"><span aria-hidden="true">&#10003;</span><span class="sr">Included</span></td><td class="yes"><span aria-hidden="true">&#10003;</span><span class="sr">Included</span></td><td class="yes"><span aria-hidden="true">&#10003;</span><span class="sr">Included</span></td><td class="yes"><span aria-hidden="true">&#10003;</span><span class="sr">Included</span></td></tr>
          <tr><th scope="row">1&times; post on the Sundance Foundation/PAC Facebook page (325 members)</th><td class="yes"><span aria-hidden="true">&#10003;</span><span class="sr">Included</span></td><td class="yes"><span aria-hidden="true">&#10003;</span><span class="sr">Included</span></td><td class="yes"><span aria-hidden="true">&#10003;</span><span class="sr">Included</span></td><td class="no"><span aria-hidden="true">&middot;</span><span class="sr">Not included</span></td></tr>
          <tr class="grp"><th scope="colgroup" colspan="5">School Presence</th></tr>
          <tr><th scope="row">Logo in the Yearbook</th><td class="yes"><span aria-hidden="true">&#10003;</span><span class="sr">Included</span></td><td class="yes"><span aria-hidden="true">&#10003;</span><span class="sr">Included</span></td><td class="yes"><span aria-hidden="true">&#10003;</span><span class="sr">Included</span></td><td class="yes"><span aria-hidden="true">&#10003;</span><span class="sr">Included</span></td></tr>
          <tr><th scope="row">&ldquo;Parking lot&rdquo; banner on the fence all year, with your logo + message</th><td class="yes"><span aria-hidden="true">&#10003;</span><span class="sr">Included</span></td><td class="yes"><span aria-hidden="true">&#10003;</span><span class="sr">Included</span></td><td class="no"><span aria-hidden="true">&middot;</span><span class="sr">Not included</span></td><td class="no"><span aria-hidden="true">&middot;</span><span class="sr">Not included</span></td></tr>
          <tr><th scope="row">Logo on the Weekly Wildcat newsletter from our Principal, all year (415 students)</th><td class="yes"><span aria-hidden="true">&#10003;</span><span class="sr">Included</span></td><td class="no"><span aria-hidden="true">&middot;</span><span class="sr">Not included</span></td><td class="no"><span aria-hidden="true">&middot;</span><span class="sr">Not included</span></td><td class="no"><span aria-hidden="true">&middot;</span><span class="sr">Not included</span></td></tr>
          </tbody>
        </table>
      </div>

      <div class="addons">
        <h3>Add on to any package</h3>
        <ul class="addon-list">
          <li>
            <div class="addon-name">&ldquo;Parking lot&rdquo; banner</div>
            <div class="addon-price num">$350</div>
            <div class="addon-note">for 6 months</div>
          </li>
          <li>
            <div class="addon-name">1&times; Facebook post</div>
            <div class="addon-price num">$250</div>
            <div class="addon-note">Foundation/PAC page</div>
          </li>
          <li>
            <div class="addon-name">Fun Run T-shirt logo</div>
            <div class="addon-price num">$750</div>
            <div class="addon-note">worn by all students &amp; staff</div>
          </li>
        </ul>
      </div>

      <p class="custom-note">Looking to make a bigger impact? <b>Custom sponsorship packages are
         available.</b> Get in touch and we&rsquo;ll build something together.</p>
    </div>
  </section>
</Base>
