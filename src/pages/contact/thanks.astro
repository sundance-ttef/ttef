---
import Base from '../../layouts/Base.astro';
---

<Base title="Message sent">
  <section>
    <div class="wrap">
      <div class="sec-head page-head">
        <div>
          <p class="eyebrow">Contact</p>
          <h2>Thanks &mdash; your message is on its way</h2>
          <p>Someone from the Foundation or PAC will get back to you, usually within a few days.</p>
        </div>
      </div>

      <div class="coming-soon">
        <div class="cs-icon" aria-hidden="true">&#128172;</div>
        <h3>While you&rsquo;re here</h3>
        <p>The calendar has every meeting and event for the school year, and the volunteer
           page lists what we need help with right now.</p>
        <div class="cs-actions">
          <a class="btn btn-primary" href="/calendar/">See the calendar</a>
          <a class="btn btn-outline" href="/volunteer/">Ways to help</a>
        </div>
      </div>
    </div>
  </section>
</Base>
