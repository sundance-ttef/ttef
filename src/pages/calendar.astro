---
import Base from '../layouts/Base.astro';
import { org } from '../data/nav';
import { getYearlyEvents, orgTag } from '../lib/sanity';
import { getCalendarEvents, matchEvent, orgOf, isZoomMeeting, timeLabel } from '../lib/calendar';

/* A scannable list above the month grid. Not duplication for its own sake: the
   embed is a third-party iframe that reads poorly on a phone and is close to
   opaque to a screen reader, so this is the accessible, fast path to "what is
   happening soon". The grid remains for browsing a month. */
const yearly = await getYearlyEvents();
const upcoming = (await getCalendarEvents({days: 90})).slice(0, 8);
/* The date chip: weekday on the coloured strip, month and day below. */
const chip = (iso: string) => {
  const d = new Date(iso + 'T12:00:00');
  return {
    dow: d.toLocaleDateString('en-US', {weekday: 'short'}).toUpperCase(),
    mon: d.toLocaleDateString('en-US', {month: 'short'}).toUpperCase(),
    day: String(d.getDate()),
  };
};
---

<Base title="Calendar">
  <section>
    <div class="wrap">
      <div class="sec-head page-head">
        <div>
          <p class="eyebrow">Calendar</p>
          <h2>School year calendar</h2>
          <p>Foundation meetings, PAC events, school holidays, and everything in between &mdash;
             straight from the Foundation&rsquo;s own Google Calendar.</p>
        </div>
      </div>

      {upcoming.length > 0 && (
        <>
          <h3 class="block-title">What&rsquo;s next</h3>
          <ul class="cal-list">
            {upcoming.map((e) => {
              const match = matchEvent(e.title, yearly);
              const tag = orgTag(match?.org ?? orgOf(e.title));
              const c = chip(e.date);
              return (
                <li class="cal-row">
                  <div class="cal-date">
                    <span class="cal-dow">{c.dow}</span>
                    <span class="cal-mon">{c.mon}</span>
                    <span class="cal-day">{c.day}</span>
                  </div>
                  <div class="cal-body">
                    <div class="cal-name">
                      {match ? <a href={`/events/${match.slug}/`}>{e.title}</a> : e.title}
                    </div>
                    <div class="cal-meta">
                      <span class="cal-time">{timeLabel(e)}</span>
                      <span class={`owner ${tag.cls}`}>{tag.label}</span>
                    </div>
                  </div>
                  {isZoomMeeting(e.title) && (
                    <a class="btn btn-outline cal-zoom" href={org.zoom}
                       target="_blank" rel="noopener noreferrer">Join by Zoom</a>
                  )}
                </li>
              );
            })}
          </ul>
        </>
      )}

      <h3 class="block-title spaced">Full calendar</h3>
      <div class="cal-frame">
        <iframe title="Twin Trails Education Foundation calendar" loading="lazy"
          src="https://calendar.google.com/calendar/embed?src=twintrailsfoundation%40gmail.com&amp;ctz=America%2FLos_Angeles&amp;mode=MONTH&amp;showTitle=0&amp;showPrint=0&amp;showTabs=1&amp;showCalendars=0"></iframe>
        <p class="cal-fallback">The live calendar renders here on the real site. This preview
           blocks external embeds, so it appears blank.</p>
      </div>

      <div class="cal-actions">
        <div class="cal-block">
          <h3>Subscribe</h3>
          <p>Add it once and every update appears in your own calendar.</p>
          <div class="sub-links">
            <a class="sub-link" href="https://calendar.google.com/calendar/render?cid=twintrailsfoundation%40gmail.com" target="_blank" rel="noopener noreferrer">Google Calendar</a>
            <a class="sub-link" href="https://calendar.google.com/calendar/ical/twintrailsfoundation%40gmail.com/public/basic.ics" target="_blank" rel="noopener noreferrer">Apple Calendar</a>
            <a class="sub-link" href="https://calendar.google.com/calendar/ical/twintrailsfoundation%40gmail.com/public/basic.ics" target="_blank" rel="noopener noreferrer">Download .ics</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
