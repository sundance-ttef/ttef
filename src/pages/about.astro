---
import Base from '../layouts/Base.astro';
---

<Base title="About Us">
  <section>
    <div class="wrap">
      <div class="sec-head page-head">
        <div>
          <p class="eyebrow">About us</p>
          <h2>Who we are</h2>
          <p>The Twin Trails Education Foundation and the Parent Activities Committee, and how
             they work together for Sundance Elementary.</p>
        </div>
      </div>

      <div class="about-photos">
        <div class="ap-item"><img class="no-photo" src="/img/no-photo.png" alt="Photo coming soon" loading="lazy" /></div>
        <div class="ap-item"><img class="no-photo" src="/img/no-photo.png" alt="Photo coming soon" loading="lazy" /></div>
        <div class="ap-item"><img class="no-photo" src="/img/no-photo.png" alt="Photo coming soon" loading="lazy" /></div>
      </div>

      <div class="duo">
        <div class="duo-side foundation">
          <div class="duo-org">Foundation</div>
          <h3>Investing in Education</h3>
          <p>The Foundation supports and enhances the <b>education, development, and overall
             well&#8209;being of our students</b> by providing resources that extend beyond
             traditional school funding.</p>
        </div>
        <div class="duo-side pac">
          <div class="duo-org">PAC</div>
          <h3>Building Community</h3>
          <p>The Parent Activities Committee, a function of the Foundation, brings families
             together and helps make Sundance Elementary a <b>fun, welcoming, and connected
             community</b>.</p>
        </div>
      </div>

      <div class="meeting-card">
        <div>
          <p class="eyebrow">Everyone is welcome</p>
          <h3>Monthly meetings, second Monday</h3>
          <p>PAC meets at 6:00&nbsp;PM and the Foundation at 7:00&nbsp;PM in the Sundance Library,
             with Zoom for anyone who can&rsquo;t make it in person. Every meeting includes an
             open forum.</p>
        </div>
        <a class="btn btn-primary" href="/contact/?to=either" >Get the Zoom link</a>
      </div>

