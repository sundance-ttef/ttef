---
import Base from '../layouts/Base.astro';
import { org } from '../data/nav';
import MeetingCard from '../components/MeetingCard.astro';
import Roster from '../components/Roster.astro';
import { getBoardPositions } from '../lib/sanity';

/* Both rosters come from one query and each Roster picks out its own seats —
   two queries would be two round trips for one small list. */
const board = await getBoardPositions();
---

<Base title="About Us">
  <section>
    <div class="wrap">
      <div class="sec-head page-head">
        <div>
          <p class="eyebrow">About us</p>
          <h2>Who we are</h2>
          <p>The Twin Trails Education Foundation (Foundation) and the Parent Activities
             Committee (PAC) work together to support Sundance Elementary.</p>
        </div>
      </div>

      <div class="duo">
        <div class="duo-side foundation">
          <div class="duo-org">Foundation</div>
          <h3>Investing in Education</h3>
          <p>The Foundation supports and enhances the <b>education, development, and overall
             well&#8209;being of our students</b> by providing resources that extend beyond
             traditional school funding.</p>
        </div>
        <div class="duo-side pac">
          <div class="duo-org">PAC</div>
          <h3>Building Community</h3>
          <p>The Parent Activities Committee, a function of the Foundation, brings families
             together and helps make Sundance Elementary a <b>fun, welcoming, and connected
             community</b>.</p>
        </div>
      </div>

      <MeetingCard />

      <Roster title="Foundation Board" year="2026–27" org="foundation" positions={board}
              contactHref="/contact/?to=foundation" buttonClass="btn-primary" />

      <Roster title="PAC Chairs" year="2026–27" org="pac" positions={board}
              contactHref="/contact/?to=pac" buttonClass="btn-pac" />

    </div>
  </section>
</Base>
