---
import Base from '../../layouts/Base.astro';
import { getTradition, eventDate, orgTag } from '../../lib/sanity';

/* The date line comes from the CMS. An unconfirmed date — or one left over
   from a previous school year — shows only the month, so a forgotten update
   can never send families on the wrong day. */
const ev = await getTradition('auction');
const when = eventDate(ev?.date, ev?.dateConfirmed);
const tag = orgTag(ev?.org ?? 'pac');
const whenText = when.full ?? (when.month ? `${when.month} \u2014 date to be announced` : 'Date to be announced');
---

<Base title="Spring Auction">
  <section>
    <div class="wrap">
      <div class="sec-head page-head">
        <div>
          <p class="eyebrow">{tag.label} &middot; {whenText}</p>
          <h2>Spring Auction</h2>
          <p>An evening out for the grown-ups, and one of the biggest nights of the Foundation&rsquo;s year.</p>
        </div>
      </div>
      <div class="stat-row">
        <div class="stat"><div class="stat-num num">$10,500+</div><div class="stat-label">Raised in 2024</div></div>
        <div class="stat"><div class="stat-num">Feb 26</div><div class="stat-label">2027 auction</div></div>
        <div class="stat"><div class="stat-num">5:30 PM</div><div class="stat-label">Doors open</div></div>
      </div>
      <div class="gallery"><div class="gal-item"><img src="/img/gala/gala-1.jpg" alt="2024 Sundance auction, photo 1" loading="lazy" /></div><div class="gal-item"><img src="/img/gala/gala-2.jpg" alt="2024 Sundance auction, photo 2" loading="lazy" /></div><div class="gal-item"><img src="/img/gala/gala-3.jpg" alt="2024 Sundance auction, photo 3" loading="lazy" /></div>
      </div>
      <div class="breakdown mt">
        <h3>Donate an item</h3>
        <p class="col-p">Local businesses and families donate the items that make the night work &mdash;
           experiences, gift certificates, services, and class projects. If you have something to
           offer, we&rsquo;d love to hear from you.</p>
        <a class="btn btn-primary" href="/contact/?to=sponsorship" >Offer an item</a>
      </div>
    </div>
  </section>
</Base>
