---
import Base from '../../layouts/Base.astro';
---

<Base title="Fun Run">
  <section>
    <div class="wrap">
      <div class="sec-head page-head">
        <div>
          <p class="eyebrow">Support us</p>
          <h2>Fun Run</h2>
          <p>Students collect pledges, then run their hearts out. School-wide goals unlock all-school celebrations.</p>
        </div>
      </div>
      <div class="stat-row">
        <div class="stat"><div class="stat-num num">$30,000</div><div class="stat-label">School-wide goal</div></div>
        <div class="stat"><div class="stat-num num">$75</div><div class="stat-label">Per-student baseline</div></div>
        <div class="stat"><div class="stat-num">Mar 26</div><div class="stat-label">2027 event</div></div>
      </div>
      <div class="two-col mt">
        <div class="breakdown">
          <h3>How it works</h3>
          <p class="col-p">Register your student, share their personal fundraising page with 10&ndash;15
             friends and family by text or email, and post it to social. Then they run.</p>
          <a class="btn btn-primary" href="/events/fun-run/">Register your student</a>
        </div>
        <aside class="breakdown">
          <h3>School-wide unlocks</h3>
          <ul class="fund-list">
            <li><span>Custom sweatbands</span><span class="amt">$20,000</span></li>
            <li><span>Pie in the Face</span><span class="amt">$25,000</span></li>
            <li><span>School-wide Field Day</span><span class="amt">$30,000</span></li>
          </ul>
        </aside>
      </div>
    </div>
  </section>
</Base>
