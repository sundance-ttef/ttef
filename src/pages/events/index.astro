---
import Base from '../../layouts/Base.astro';
import { getYearlyEvents, imageUrl, orgTag, traditionWhen } from '../../lib/sanity';

/* Events is now only about the main yearly events. The upcoming-dates list and
   the dine-out teaser moved off: dates live on /calendar/, and Dine Out Nights
   is linked from Support Us as a way to give. */
const events = await getYearlyEvents();
---

<Base title="Events">
  <section>
    <div class="wrap">
      <div class="sec-head page-head">
        <div>
          <p class="eyebrow">Events</p>
          <h2>Events at Sundance</h2>
          <p>The traditions that shape the year at Sundance.</p>
        </div>
      </div>


      <div class="events events-3">
        {events.map((e) => {
          const tag = orgTag(e.org);
          const cover = imageUrl(e.coverImage, 560, 380);
          return (
            <a class={`event event-static is-link ${tag.cls}`} href={`/events/${e.slug}/`}>
              <div class="event-img is-placeholder">
                {cover
                  ? <img class="event-photo" src={cover} alt={e.coverImage?.alt ?? e.title} loading="lazy" />
                  : <img class="no-photo" src="/img/no-photo.png" alt="Photo coming soon" loading="lazy" />}
              </div>
              <div class="event-body">
                <div class="event-meta">
                  <span class={`owner ${tag.cls}`}>{tag.label}</span>
                  <span class="event-date">{traditionWhen(e).short}</span>
                </div>
                <h3>{e.title}</h3>
                <p>{e.summary}</p>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</Base>
