---
import Base from '../../layouts/Base.astro';
import { getUpcoming, getDineOutNights, orgTag, dateChip } from '../../lib/sanity';

const upcoming = await getUpcoming(12);

/* The dine-out teaser shows only the next night; the full schedule lives on
   its own page. Undated months count as upcoming — an unscheduled month is
   still ahead of us. */
const today = new Date().toISOString().slice(0, 10);
const nextDineOut = (await getDineOutNights()).find((n) => !n.date || n.date >= today);
---

<Base title="Events">
  <section>
    <div class="wrap">
      <div class="sec-head page-head">
        <div>
          <p class="eyebrow">Events</p>
          <h2>Events at Sundance</h2>
          <p>What&rsquo;s coming up next, and the traditions that shape the year. Each one is
             labelled with who runs it.</p>
        </div>
      </div>

      <h3 class="block-title">Upcoming dine out nights</h3>
      <div class="dineout-upcoming">
        <ul class="up-list">
          {nextDineOut && (
            <li class="up-row">
              <div class="up-date">
                <span class="up-mon">{nextDineOut.date ? dateChip(nextDineOut.date).mon : nextDineOut.month.slice(0, 3).toUpperCase()}</span>
                <span class="up-day">{nextDineOut.date ? dateChip(nextDineOut.date).day : '\u2014'}</span>
              </div>
              <div class="up-body">
                <div class="up-name">{nextDineOut.month} dine out{nextDineOut.restaurant ? ` \u2014 ${nextDineOut.restaurant}` : ' \u2014 coming soon'}</div>
                <div class="up-time">{nextDineOut.restaurant ? nextDineOut.blurb : 'Restaurant and date to be announced'}</div>
              </div>
              <span class="owner p">PAC</span>
            </li>
          )}
        </ul>
        <a class="btn btn-outline" href="/events/dine-out/">All dine out nights</a>
      </div>

      <h3 class="block-title">Coming up next</h3>
      <div class="upcoming">
        <ul class="up-list">
          {upcoming.map((e) => {
            const tag = orgTag(e.org);
            const chip = dateChip(e.date);
            const row = (
              <>
                <div class="up-date"><span class="up-mon">{chip.mon}</span><span class="up-day">{chip.day}</span></div>
                <div class="up-body">
                  <div class="up-name">{e.href ? <a class="up-link" href={`/events/${e.href}/`}>{e.name}</a> : e.name}</div>
                  <div class="up-time">{e.time}</div>
                </div>
                <span class={`owner ${tag.cls}`}>{tag.label}</span>
              </>
            );
            return <li class="up-row">{row}</li>;
          })}
        </ul>
        <a class="btn btn-primary" href="/calendar/">See the full calendar</a>
      </div>

      <h3 class="block-title spaced">Every year at Sundance</h3>
      <p class="block-lede">These come around every school year, roughly in this order.</p>
      <div class="events events-3">
        <a class="event event-static is-link" href="/events/book-fair/">
          <div class="event-img is-placeholder"><img class="event-photo" src="/img/events/book-fair.jpg" alt="Book Fair banner: read more, learn more, dream more" loading="lazy" /></div>
          <div class="event-body">
            <div class="event-meta"><span class="owner p">PAC</span><span class="event-date">October</span></div>
            <h3>Book Fair</h3>
            <p>A week of books in the library, with proceeds coming back to Sundance.</p>
          </div>
        </a>
        <a class="event event-static is-link" href="/events/carnival/">
          <div class="event-img is-placeholder"><img class="no-photo" src="/img/no-photo.png" alt="Photo coming soon" loading="lazy" /></div>
          <div class="event-body">
            <div class="event-meta"><span class="owner p">PAC</span><span class="event-date">October</span></div>
            <h3>Fall Carnival</h3>
            <p>Games, food, and the biggest family night of the fall.</p>
          </div>
        </a>
        <a class="event event-static is-link" href="/events/multicultural-night/">
          <div class="event-img is-placeholder"><img class="no-photo" src="/img/no-photo.png" alt="Photo coming soon" loading="lazy" /></div>
          <div class="event-body">
            <div class="event-meta"><span class="owner p">PAC</span><span class="event-date">January</span></div>
            <h3>Multicultural Night</h3>
            <p>Families share the food, dress, music, and traditions of home.</p>
          </div>
        </a>
        <a class="event event-static is-link" href="/events/auction/">
          <div class="event-img is-placeholder"><img class="event-photo" src="/img/gala/gala-3.jpg" alt="Guests at the 2024 Sundance auction" loading="lazy" /></div>
          <div class="event-body">
            <div class="event-meta"><span class="owner f">Foundation</span><span class="event-date">February</span></div>
            <h3>Spring Auction</h3>
            <p>An evening out for the grown-ups. The 2024 auction raised over $10,500.</p>
          </div>
        </a>
        <a class="event event-static is-link" href="/events/fun-run/">
          <div class="event-img is-placeholder"><img class="event-photo" src="/img/events/fun-run-1.jpg" alt="Sundance students running in the 2025 Fun Run" loading="lazy" /></div>
          <div class="event-body">
            <div class="event-meta"><span class="owner f">Foundation</span><span class="event-date">March</span></div>
            <h3>Fun Run</h3>
            <p>Students collect pledges and run. School-wide goals unlock celebrations.</p>
          </div>
        </a>
        <a class="event event-static is-link" href="/events/talent-show/">
          <div class="event-img is-placeholder"><img class="event-photo" src="/img/events/talent-show-3.jpg" alt="Students performing at the 2025 Sundance talent show" loading="lazy" /></div>
          <div class="event-body">
            <div class="event-meta"><span class="owner p">PAC</span><span class="event-date">Spring</span></div>
            <h3>Talent Show</h3>
            <p>Auditions, rehearsals, and a night on stage.</p>
          </div>
        </a>
        <a class="event event-static is-link" href="/events/senior-clap-out/">
          <div class="event-img is-placeholder"><img class="no-photo" src="/img/no-photo.png" alt="Photo coming soon" loading="lazy" /></div>
          <div class="event-body">
            <div class="event-meta"><span class="owner p">PAC</span><span class="event-date">June</span></div>
            <h3>Senior Clap Out</h3>
            <p>Sundance alumni come back to walk the halls one last time.</p>
          </div>
        </a>
      </div>
    </div>
  </section>
</Base>
