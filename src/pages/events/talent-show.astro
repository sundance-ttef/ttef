---
import Base from '../../layouts/Base.astro';
---

<Base title="Talent Show">
  <section>
    <div class="wrap">
      <div class="sec-head page-head">
        <div>
          <p class="eyebrow">PAC &middot; Spring</p>
          <h2>Talent Show</h2>
          <p>Auditions, rehearsals, and a night on stage.</p>
        </div>
      </div>
      <div class="photo-strip">
        <div class="ps-item"><img class="no-photo" src="/img/events/talent-show-1.jpg" alt="2025 Sundance talent show, photo 1" loading="lazy" /></div>
        <div class="ps-item"><img class="no-photo" src="/img/events/talent-show-2.jpg" alt="2025 Sundance talent show, photo 2" loading="lazy" /></div>
        <div class="ps-item"><img class="no-photo" src="/img/events/talent-show-3.jpg" alt="2025 Sundance talent show, photo 3" loading="lazy" /></div>
        <div class="ps-item"><img class="no-photo" src="/img/events/talent-show-4.jpg" alt="2025 Sundance talent show, photo 4" loading="lazy" /></div>
      </div>
      <p class="ps-caption">Last year&rsquo;s talent show.</p>

      <div class="coming-soon">
        <div class="cs-icon" aria-hidden="true">&#128197;</div>
        <h3>Information for 2027 coming soon</h3>
        <p>We&rsquo;re finalising this year&rsquo;s plans. Check the calendar for the date, and
           we&rsquo;ll post full details here as soon as they&rsquo;re set.</p>
        <div class="cs-actions">
          <a class="btn btn-primary" href="/calendar/">See the calendar</a>
          <a class="btn btn-outline" href="/volunteer/">Help run it</a>
        </div>
      </div>
    </div>
  </section>
</Base>
