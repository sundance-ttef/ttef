---
import Base from '../../layouts/Base.astro';
import { getTradition, eventDate, orgTag } from '../../lib/sanity';

/* The date line comes from the CMS. An unconfirmed date — or one left over
   from a previous school year — shows only the month, so a forgotten update
   can never send families on the wrong day. */
const ev = await getTradition('senior-clap-out');
const when = eventDate(ev?.date, ev?.dateConfirmed);
const tag = orgTag(ev?.org ?? 'pac');
const whenText = when.full ?? (when.month ? `${when.month} \u2014 date to be announced` : 'Date to be announced');
---

<Base title="Senior Clap Out">
  <section>
    <div class="wrap">
      <div class="sec-head page-head">
        <div>
          <p class="eyebrow">{tag.label} &middot; {whenText}</p>
          <h2>Senior Clap Out</h2>
          <p>Sundance alumni come back to walk the halls one last time.</p>
        </div>
      </div>
      <div class="coming-soon">
        <div class="cs-icon" aria-hidden="true">&#128197;</div>
        <h3>2026&ndash;27 details coming soon</h3>
        <p>We&rsquo;re finalising this year&rsquo;s plans. Check the calendar for the date, and
           we&rsquo;ll post full details here as soon as they&rsquo;re set.</p>
        <div class="cs-actions">
          <a class="btn btn-primary" href="/calendar/">See the calendar</a>
          <a class="btn btn-outline" href="/volunteer/">Help run it</a>
        </div>
      </div>
    </div>
  </section>
</Base>
