---
/**
 * Every event page that lives directly under /events/, from one route.
 *
 * Two different things land here, and the props say which:
 *
 *   a TRADITION — Book Fair, Fall Carnival, the Auction. Identified by name,
 *     recurs every year, listed on the Events grid and in the Events menu.
 *     These were once seven near-identical files that drifted: five were the
 *     same placeholder shell, two had hand-built stats and galleries, and NONE
 *     rendered the photos editors had uploaded. One route means a new event
 *     added in the Studio gets a real page with no code.
 *
 *   a ONE-OFF dated event — identified by its date, happens once, listed
 *     nowhere. It has a page so there is something to put on a flyer; it stays
 *     off the Events grid so ad-hoc things do not pile up there.
 *
 * A dated event that belongs to a SERIES does not come here — it nests under
 * its series instead, at /events/dine-out/<url>/.
 *
 * The URL comes from the slug, so the paths printed on flyers and pointed at by
 * the old-site redirects keep working.
 */
import Base from '../../layouts/Base.astro';
import TraditionPage from '../../components/TraditionPage.astro';
import DatedEvent from '../../components/DatedEvent.astro';
import { getTraditions, getTradition, getOneOffEvents, isBooked } from '../../lib/sanity';

export async function getStaticPaths() {
  const [traditions, oneOffs] = await Promise.all([getTraditions(), getOneOffEvents()]);
  const booked = oneOffs.filter(isBooked);

  /* A one-off sharing a slug with an annual event would collide as an opaque
     Astro duplicate-route error. Name the offender instead — and let the
     tradition win, since its url is the one on the printed QR codes. */
  const taken = new Set(traditions.map((t) => t.slug));
  for (const e of booked) {
    if (taken.has(e.slug!)) {
      throw new Error(
        `The one-off event "${e.title}" uses the url "${e.slug}", which is already an annual event. Give it a different URL in the Studio.`,
      );
    }
    taken.add(e.slug!);
  }

  return [
    ...traditions.map((t) => ({ params: { slug: t.slug }, props: { oneOff: null } })),
    ...booked.map((e) => ({ params: { slug: e.slug! }, props: { oneOff: e } })),
  ];
}

const { oneOff } = Astro.props;
const { slug } = Astro.params;

/* Only the tradition needs a second fetch: its page uses fields the grid query
   does not select. A one-off arrives whole in props. */
const ev = oneOff ? null : await getTradition(slug!);
if (!oneOff && !ev) throw new Error(`No event in Sanity with slug "${slug}"`);
---

<Base title={oneOff ? oneOff.title! : ev!.title}>
  {oneOff
    ? <DatedEvent event={oneOff} back={{ href: '/events/', label: 'All events' }} />
    : <TraditionPage event={ev!} />}
</Base>
