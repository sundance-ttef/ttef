---
import Base from '../layouts/Base.astro';
import Sponsors from '../components/Sponsors.astro';
import { fundraising, goalText } from '../data/fundraising';
---

<Base title="home">
  <!-- HERO -->
  <div class="hero">
    <div class="hero-photo">
      <img src="/img/hero.jpg" alt="Sundance Elementary students gathered on the blacktop for an all-school assembly">
      <div class="hero-copy">
        <div class="wrap">
          <h1>Making Sundance Elementary the best it can be</h1>
          <p>Family giving funds the teachers, programs, and everyday experiences that district
             funding alone can&rsquo;t reach.</p>
          <div class="hero-cta">
            <a class="btn btn-lg btn-onphoto" href="/donate/">Donate now</a>
            <a class="btn btn-lg btn-ghost-light" href="/impact/">See what we fund</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- FOUNDATION / PAC -->
  <section class="together" id="about">
    <div class="wrap">
      <div class="together-head">
        <h2>Stronger Together for Sundance Elementary</h2>
        <p>At Sundance Elementary, our Foundation and Parent Activities Committee (PAC) work
           hand in hand to create an exceptional school experience. While each has a different
           focus, both share the same goal: supporting our students, teachers, and families.</p>
      </div>

      <div class="duo">
        <div class="duo-side foundation">
          <div class="duo-org">Foundation</div>
          <h3>Investing in Education</h3>
          <p>The Foundation supports and enhances the <b>education, development, and overall
             well&#8209;being of our students</b> by providing resources that extend beyond
             traditional school funding.</p>
          <div class="duo-label">The Foundation helps fund:</div>
          <ul class="duo-list">
            <li>Critical staff positions</li>
            <li>Online learning programs</li>
            <li>Computer and technology upgrades</li>
            <li>Fine and performing arts</li>
            <li>Music and foreign languages</li>
            <li>Health and physical education</li>
            <li>Additional classroom supplies and materials</li>
          </ul>
        </div>

        <div class="duo-side pac">
          <div class="duo-org">PAC</div>
          <h3>Building Community</h3>
          <p>The Parent Activities Committee (PAC), a function of the Foundation, brings families
             together and helps make Sundance Elementary a <b>fun, welcoming, and connected
             community</b>.</p>
          <div class="duo-label">PAC volunteers help organize:</div>
          <ul class="duo-list">
            <li>School dances</li>
            <li>Dine&#8209;out nights</li>
            <li>Book fairs</li>
            <li>Fall Carnival</li>
            <li>Family activities</li>
            <li>And many more special events throughout the year</li>
          </ul>
        </div>
      </div>

    </div>
  </section>

  <!-- EVENTS -->
  <section id="events">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow">What&rsquo;s next</p>
          <h2>Upcoming events</h2>
        </div>
        <a class="link-more" href="/calendar/">View full calendar &rarr;</a>
      </div>
      <div class="events">
        <a class="event" href="/calendar/">
          <div class="event-img"><img src="/img/funrun.jpg" alt="Volunteers gathered under the Fun Run finish line arch"></div>
          <div class="event-body">
            <div class="event-meta"><span class="owner p">PAC</span><span class="event-date">Fri, Sep 11 &middot; 5:30&ndash;7:30 PM</span></div>
            <h3>Back to School Dance</h3>
            <p>The first big family night of the year. Music, dancing, and a chance to meet
               your Wildcat&rsquo;s new classmates.</p>
          </div>
        </a>
        <a class="event" href="/calendar/">
          <div class="event-img"><img src="/img/birding.jpg" alt="Students using binoculars on a field trip with a teacher"></div>
          <div class="event-body">
            <div class="event-meta"><span class="owner f">Foundation</span><span class="event-date">Mon, Sep 14 &middot; 7:00&ndash;8:00 PM</span></div>
            <h3>Monthly Foundation Meeting</h3>
            <p>Second Monday of every month in the Sundance Library, with Zoom. Everyone is
               welcome, and there&rsquo;s always an open forum.</p>
          </div>
        </a>
        <a class="event" href="/calendar/">
          <div class="event-img"><img src="/img/beautify.jpg" alt="Families and students volunteering together in the school parking lot"></div>
          <div class="event-body">
            <div class="event-meta"><span class="owner p">PAC</span><span class="event-date">Sat, Sep 19 &middot; 10:00 AM&ndash;12:00 PM</span></div>
            <h3>Bike Rodeo</h3>
            <p>A morning of bike safety, skills, and games on campus for riders of every age
               and confidence level.</p>
          </div>
        </a>
      </div>
    </div>
  </section>







  <!-- IMPACT TEASER -->
  <section class="impact-teaser">
    <div class="wrap">
      <div class="teaser-inner">
        <div>
          <p class="eyebrow">Our impact</p>
          <h2>We need your help to fill the gap</h2>
          <p>State funding doesn&rsquo;t cover the enrichment programs that make Sundance what it
             is. Family giving pays for four staff positions, the science lab, music and choir,
             reading intervention, clubs, and classroom supplies. Our {fundraising.schoolYear} goal
             is <b>{goalText}</b>.</p>
        </div>
        <a class="btn btn-lg btn-primary" href="/impact/">See what we fund</a>
      </div>
    </div>
  </section>

  <!-- SUPPORT TEASER -->
  <section class="support-teaser">
    <div class="wrap">
      <p class="eyebrow give-eyebrow">Support us</p>
      <h2>Every penny goes straight to the classroom</h2>
      <p class="give-lead">Our suggested contribution is <b>$250 per student</b> &mdash; the lowest
         ask of any comparable school in Poway Unified. Give any amount, once or monthly, and
         your employer may double it.</p>
      <div class="give-actions">
        <a class="btn btn-lg btn-onphoto" href="/donate/">Donate now</a>
        <a class="btn btn-lg btn-ghost-light" href="/support/">All the ways to give</a>
      </div>
    </div>
  </section>

  <Sponsors />
</Base>
