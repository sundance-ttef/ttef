---
import Base from '../layouts/Base.astro';
import { askText } from '../data/fundraising';
import Sponsors from '../components/Sponsors.astro';
import { fundraising, goalText, raisedText, remainingText, percent } from '../data/fundraising';
import UpcomingEvents from '../components/UpcomingEvents.astro';

---

<Base title="home">
  <!-- HERO -->
  <div class="hero">
    <div class="hero-photo">
      <img src="/img/hero.jpg" alt="Sundance Elementary students gathered on the blacktop for an all-school assembly">
      <div class="hero-copy">
        <div class="wrap">
          <h1>Making Sundance Elementary the best it can be</h1>
          <p>Family giving funds the teachers, programs, and everyday experiences that district
             funding alone can&rsquo;t reach.</p>
          <div class="hero-cta">
            <a class="btn btn-lg btn-primary" href="/donate/">Donate now</a>
            <a class="btn btn-lg btn-ghost-light" href="/impact/">See what we fund</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- FOUNDATION / PAC -->
  <section class="together" id="about">
    <div class="wrap">
      <div class="together-head">
        <h2>Stronger Together for Sundance Elementary</h2>
        <p>At Sundance Elementary, our Foundation and Parent Activities Committee (PAC) work
           hand in hand to create an exceptional school experience. While each has a different
           focus, both share the same goal: supporting our students, teachers, and families.</p>
      </div>

      <div class="duo">
        <div class="duo-side foundation">
          <div class="duo-org">Foundation</div>
          <h3>Investing in Education</h3>
          <p>The Foundation supports and enhances the <b>education, development, and overall
             well&#8209;being of our students</b> by providing resources that extend beyond
             traditional school funding.</p>
          <div class="duo-label">The Foundation helps fund:</div>
          <ul class="duo-list">
            <li>Critical staff positions</li>
            <li>Online learning programs</li>
            <li>Computer and technology upgrades</li>
            <li>Fine and performing arts</li>
            <li>Music and foreign languages</li>
            <li>Health and physical education</li>
            <li>Additional classroom supplies and materials</li>
          </ul>
        </div>

        <div class="duo-side pac">
          <div class="duo-org">PAC</div>
          <h3>Building Community</h3>
          <p>The Parent Activities Committee (PAC), a function of the Foundation, brings families
             together and helps make Sundance Elementary a <b>fun, welcoming, and connected
             community</b>.</p>
          <div class="duo-label">PAC volunteers help organize:</div>
          <ul class="duo-list">
            <li>School dances</li>
            <li>Dine&#8209;out nights</li>
            <li>Book fairs</li>
            <li>Fall Carnival</li>
            <li>Family activities</li>
            <li>And many more special events throughout the year</li>
          </ul>
        </div>
      </div>

    </div>
  </section>

  <!-- EVENTS -->
  <section id="events">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow">What&rsquo;s next</p>
          <h2>Upcoming events</h2>
        </div>
        <a class="link-more" href="/calendar/">View full calendar &rarr;</a>
      </div>
      <UpcomingEvents limit={3} headlinesOnly={true} />
    </div>
  </section>







  <!-- THE ASK -->
  <section class="the-ask">
    <div class="wrap">
      <p class="eyebrow">Our impact</p>
      <h2>We need your help to fill the gap</h2>
      <p class="ask-lead">State funding doesn&rsquo;t cover the enrichment programs that make
         Sundance what it is. Family giving pays for four staff positions, the science lab,
         music and choir, reading intervention, clubs, and classroom supplies.</p>
      <p class="ask-lead">Our {fundraising.schoolYear} goal is <b>{goalText}</b> &mdash; a
         suggested <b>{askText} per student</b>, the lowest ask of any comparable school in
         Poway Unified. Give any amount, once or monthly, and your employer may double it.</p>
      {/* The gap, made visible in the section that asks you to fill it. Before
          the campaign opens nothing has been raised, and saying "$0 raised ·
          0% of $111,944" next to "$111,944 to go" states the same figure three
          times over — so the empty bar simply names the goal. */}
      <div class="ask-progress">
        <div class="bar"><div class="bar-fill" style={`width:${percent}%`}></div></div>
        <div class="bar-legend">
          {fundraising.raised > 0 ? (
            <>
              <span><span class="num">{raisedText}</span> raised &middot; {percent}% funded</span>
              <span class="num">{remainingText} to go</span>
            </>
          ) : (
            <>
              <span>Our {fundraising.schoolYear} goal</span>
              <span class="num">{goalText}</span>
            </>
          )}
        </div>
      </div>

      <div class="ask-actions">
        <a class="btn btn-lg btn-ghost-light" href="/impact/">See what we fund</a>
        <a class="btn btn-lg btn-onphoto" href="/volunteer/">Volunteer</a>
        <a class="btn btn-lg btn-onphoto" href="/donate/">Donate</a>
      </div>
    </div>
  </section>

  {/* A way to give by SHOPPING, so it sits with the ask rather than on the
      sponsor wall below — sponsors gave us money, Tagaby is something to go
      and do. Compact on purpose: the front page is already carrying the
      campaign, the events and the sponsors. */}
  <section class="tagaby-teaser">
    <div class="wrap">
      <div class="teaser-inner">
        <div>
          <p class="eyebrow">PAC &middot; Tagaby</p>
          <h2>Help reduce Lost &amp; Found</h2>
          <p>Sundance donates nearly <b>800 unclaimed items</b> every year. Tagaby tags help
             them find their way home &mdash; and <b>20% of profits</b> comes back to the PAC.</p>
        </div>
        <a class="btn btn-lg btn-primary" href="/tagaby/">How Tagaby works</a>
      </div>
    </div>
  </section>

  <Sponsors />
</Base>
