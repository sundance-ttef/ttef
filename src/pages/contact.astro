---
import Base from '../layouts/Base.astro';
---

<Base title="Contact">
  <section>
    <div class="wrap">
      <div class="sec-head page-head">
        <div>
          <p class="eyebrow">Contact</p>
          <h2>Get in touch</h2>
          <p>Questions about donating, volunteering, events, or sponsorship.</p>
        </div>
      </div>
      <div class="contact-grid">
        <form
          class="contact-form"
          name="contact"
          method="POST"
          action="/contact/thanks/"
          data-netlify="true"
          netlify-honeypot="website"
        >
          {/* Netlify needs the form name in the payload */}
          <input type="hidden" name="form-name" value="contact" />
          {/* Honeypot: hidden from people, filled in by bots */}
          <p class="hp-field" aria-hidden="true">
            <label>Leave this empty<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
          </p>

          <label>Your name<input type="text" name="name" required placeholder="Jane Wildcat" /></label>
          <label>Email<input type="email" name="email" required placeholder="jane@example.com" /></label>
          <label for="contact-to">This is for
            <select id="contact-to" name="recipient">
              <option value="other">Other</option>
              <option value="foundation">The Foundation &mdash; donating, sponsorship, funding</option>
              <option value="pac">PAC &mdash; events and activities</option>
              <option value="sponsorship">Corporate sponsorship</option>
            </select>
          </label>
          <label>Message<textarea name="message" rows="5" required placeholder="How can we help?"></textarea></label>
          <button class="btn btn-primary" type="submit">Send message</button>
          <p class="form-note">We usually reply within a few days.</p>
        </form>
        <aside class="contact-card">
          <h3>Twin Trails Education Foundation</h3>
          <p>8944 Twin Trails Drive<br>San Diego, CA 92129</p>
          <p><a href="tel:8584842950">858&#8209;484&#8209;2950</a></p>
          <hr>
          <p><b>Foundation</b><br><a href="mailto:Sundance-Foundation@GoogleGroups.com">Sundance-Foundation@GoogleGroups.com</a></p>
          <p><b>PAC</b><br><a href="mailto:pacsundancepq@gmail.com">pacsundancepq@gmail.com</a></p>
          <p><b>Finance &amp; reimbursements</b><br><a href="mailto:sundance-finance@googlegroups.com">sundance-finance@googlegroups.com</a></p>
          <hr>
          <p class="ein-line">501(c)(3) non-profit<br>Federal Tax ID <span class="num">20&#8209;1105904</span></p>
        </aside>
      </div>
    </div>
  </section>
</Base>

<script>
  // Sponsorship and volunteer CTAs link here with ?to=..., so nobody lands on a
  // blank dropdown after clicking "Become a sponsor".
  const to = new URLSearchParams(location.search).get('to');
  const sel = document.getElementById('contact-to') as HTMLSelectElement | null;
  if (to && sel && [...sel.options].some((o) => o.value === to)) sel.value = to;
</script>
