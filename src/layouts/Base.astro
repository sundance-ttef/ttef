---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { org } from '../data/nav';

interface Props {
  title: string;
  description?: string;
  /** Pages whose first section is a dark band opt out of the standard top padding. */
  darkTop?: boolean;
}

const {
  title,
  description = `${org.name} supports ${org.school} — funding staff, enrichment programs, and the events that bring our families together.`,
  darkTop = false,
} = Astro.props;

const fullTitle = title === 'home' ? `${org.name}` : `${title} — ${org.name}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {/* Without an explicit share image, iMessage and friends guess — and pick
        the biggest image on the page (the Tagaby graphic once). The card is
        the white logo on the maroon band gradient, 1200×630. It lives on the
        Netlify URL, not the public domain: the domain still serves the old
        WordPress site, so an image URL on it 404s and the scraper falls back
        to guessing again. The Netlify URL resolves today and keeps resolving
        after the domain is pointed. */}
    <meta property="og:image" content="https://sundance-ttef.netlify.app/img/og-share.png" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <Header />
    <main class={darkTop ? 'page-top page-top--dark' : 'page-top'}>
      <slot />
    </main>
    <Footer />

    <script>
      // Mobile menu
      const btn = document.getElementById('navToggle');
      const nav = document.getElementById('mainNav');
      if (btn && nav) {
        btn.addEventListener('click', () => {
          const open = nav.classList.toggle('open');
          btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
      }

      // Nav dropdowns
      const closeMenus = () => {
        document.querySelectorAll('.nav-item.has-menu').forEach((o) => {
          o.classList.remove('is-open');
          o.querySelector('.nav-trigger')?.setAttribute('aria-expanded', 'false');
        });
      };
      document.querySelectorAll('.nav-item.has-menu').forEach((item) => {
        const trigger = item.querySelector('.nav-trigger');
        trigger?.addEventListener('click', (e) => {
          e.stopPropagation();
          const wasOpen = item.classList.contains('is-open');
          closeMenus();
          if (!wasOpen) {
            item.classList.add('is-open');
            trigger.setAttribute('aria-expanded', 'true');
          }
        });
      });
      document.addEventListener('click', closeMenus);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeMenus();
      });
    </script>
  </body>
</html>
