---
/**
 * The "what's coming up" cards, shared by the home page and /calendar/.
 *
 * Dates come from the school's Google Calendar, which the PAC already keeps up
 * to date. An entry whose title matches one of the annual events links to that
 * event's page and borrows its description and its org, which is real data
 * rather than the guess made from the title.
 */
import { getYearlyEvents, getDineOutNights, orgTag } from '../lib/sanity';
import { getCalendarEvents, matchEvent, orgOf, timeLabel, isZoomMeeting, isRoutine, splitLocation, mapsUrl } from '../lib/calendar';
import { org } from '../data/nav';

interface Props {
  /** How many cards to show. */
  limit?: number;
  /** How far ahead to look. */
  days?: number;
  /**
   * Headline mode (home page): routine staff entries (VAPA, Friday Flag) are
   * skipped — EXCEPT any that land before the first headline event, so a
   * quiet stretch never reads as "nothing happening until September".
   * False on /calendar/, which is meant to be complete.
   */
  headlinesOnly?: boolean;
}

const { limit = 3, days = 120, headlinesOnly = false } = Astro.props;

const yearly = await getYearlyEvents();
const dineOut = await getDineOutNights();
const all = await getCalendarEvents({ days });

/* Candidates a calendar entry can match, in order: a specific dine-out night
   ("Ike's Love & Sandwiches") beats the "Dine Out Nights" series when both
   share words with the calendar title, because .find() takes the first hit. */
const candidates = [
  ...dineOut.filter((d) => d.slug).map((d) => ({title: d.title, slug: `dine-out/${d.slug}`, org: 'pac' as const, summary: d.summary})),
  ...yearly.map((y) => ({title: y.title, slug: y.slug, org: y.org, summary: y.summary})),
];

const events = headlinesOnly
  ? (() => {
      const firstHeadline = all.findIndex((e) => !isRoutine(e.title));
      const gap = firstHeadline > 0 ? all.slice(0, firstHeadline) : [];
      const headlines = all.filter((e) => !isRoutine(e.title));
      return [...gap, ...headlines].slice(0, limit);
    })()
  : all.slice(0, limit);
---

{events.length > 0 && (
  <div class="events">
    {events.map((e) => {
      const match = matchEvent(e.title, candidates);
      const tag = orgTag(match?.org ?? orgOf(e.title));
      const zoom = isZoomMeeting(e.title);
      /* The card is not a link: the footer holds real utility links (Maps,
         Zoom), and nested anchors are invalid HTML. The TITLE links when the
         event has a page — the same "only link what goes somewhere" rule,
         one level down. */
      const pageHref = match ? `/events/${match.slug}/` : null;
      const d = new Date(e.date + 'T12:00:00');
      const when = d.toLocaleDateString('en-US', {weekday: 'short', month: 'short', day: 'numeric'});
      const place = e.location ? splitLocation(e.location) : null;
      return (
        <div class={`event ${tag.cls}`}>
          {/* Date and time lead in a tinted header band, with the org chip
              at the other end — the when and the whose are the two things a
              scanning family needs first, so they share the top row. */}
          <div class="event-when">
            <span class="ew-left">
              <span class="ew-date">{when}</span>
              <span class="ew-time">{timeLabel(e)}</span>
            </span>
            <span class={`owner ${tag.cls}`}>{tag.label}</span>
          </div>
          <h3>{pageHref ? <a href={pageHref}>{e.title}</a> : e.title}</h3>
          {/* A matched event shows its curated page summary; anything else
              falls back to whatever the calendar entry itself says. */}
          {match ? <p>{match.summary}</p> : e.description && <p>{e.description}</p>}
          {(place || zoom) && (
            <div class="event-foot">
              {place && (
                <a class="event-where" href={mapsUrl(place.raw)} target="_blank" rel="noopener noreferrer">
                  <span class="ew-name">{place.name}</span>
                  {place.addr && <span class="ew-addr">{place.addr}</span>}
                </a>
              )}
              {zoom && <a class="event-zoom" href={org.zoom} target="_blank" rel="noopener noreferrer">Join by Zoom &rarr;</a>}
            </div>
          )}
        </div>
      );
    })}
  </div>
)}
