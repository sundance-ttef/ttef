---
/**
 * An internal "still to do" note, shown ONLY while running locally.
 *
 * These record open questions — unconfirmed spellings of real people's names,
 * missing photos, decisions still owed — and must never reach a visitor.
 * `import.meta.env.DEV` is false in `astro build`, so nothing here is emitted
 * into the production HTML at all: it isn't hidden with CSS, it doesn't exist.
 */
interface Props {
  title?: string;
}
const { title = 'Content needed' } = Astro.props;
const show = import.meta.env.DEV;
---

{
  show && (
    <div class="needs">
      <h3>⚠️ {title}</h3>
      <ul>
        <slot />
      </ul>
    </div>
  )
}
