---
/**
 * The home-page sponsor rail.
 *
 * This was a JavaScript marquee: it measured tile widths, cloned tiles until
 * the row was wide enough to loop, and animated scrollLeft each frame. That is
 * three things that can fail before a logo ever appears — and it did fail,
 * invisibly, for a real visitor whose browser had not loaded the images the
 * script was measuring.
 *
 * It is now a CSS animation over a row that is duplicated HERE, at build time.
 * No measuring, no cloning, no scroll position, no script at all: if the CSS
 * animation does not run, the sponsors are simply a static row, which is a
 * perfectly good outcome. The duplicate is aria-hidden so a screen reader
 * hears each sponsor once.
 */
import { sponsors, tiers } from '../data/sponsors';

const tierLabel = (t: string) => tiers.find((x) => x.key === t)?.label ?? t;
/* Two passes of the same list, so translating by exactly -50% loops seamlessly. */
const passes = [
  { key: 'a', hidden: false },
  { key: 'b', hidden: true },
];
---

<section class="sponsors sponsor-strip" id="sponsors-home">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <p class="eyebrow">Thank you</p>
        <h2>Our corporate sponsors</h2>
        <p>Local businesses who fund Sundance directly. Sponsorships start at $250.</p>
      </div>
      <a class="btn btn-gold" href="/sponsorship/">Become a sponsor</a>
    </div>

    <div class="sponsor-rail">
      <div class="sponsor-marquee">
        {passes.map((pass) => (
          <div class="strip-track" aria-hidden={pass.hidden ? 'true' : undefined}>
            {sponsors.map((s) => (
              <a
                class={`strip-item t-${s.tier}`}
                href={s.url}
                target="_blank"
                rel="noopener noreferrer"
                tabindex={pass.hidden ? -1 : undefined}
              >
                <span class="tier-tab" aria-hidden="true">{tierLabel(s.tier)}</span>
                {/* The name is the alt text rather than a separate visually
                    hidden span, so a logo that fails to load — blocked CDN,
                    slow connection, image host down — leaves the sponsor's
                    name on screen instead of an empty box. */}
                <span class="strip-logo">
                  <img src={s.logo} alt={`${s.name} — ${tierLabel(s.tier)} sponsor`}
                       decoding="async" width="250" height="92" />
                </span>
              </a>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
