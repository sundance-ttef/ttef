---
import { nav, social } from '../data/nav';

const { pathname } = Astro.url;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/">
      <img class="brand-logo" src="/img/ttef-logo.png"
           alt="Sundance Elementary Twin Trails Foundation and PAC" width="760" height="199" />
    </a>

    <button class="nav-toggle" id="navToggle" aria-expanded="false" aria-controls="mainNav">Menu</button>

    <nav class="nav" id="mainNav" aria-label="Main">
      {nav.map((item) =>
        item.children ? (
          <div class="nav-item has-menu">
            <button class="nav-trigger" type="button" aria-expanded="false" aria-haspopup="true">
              {item.label}<span class="caret" aria-hidden="true">▾</span>
            </button>
            <div class="nav-menu" role="menu">
              {item.children.map((child) => (
                <a
                  href={child.href}
                  role="menuitem"
                  class={child.overview ? 'menu-overview' : undefined}
                  aria-current={pathname === child.href ? 'page' : undefined}
                >
                  <span>{child.label}</span>
                  {child.meta && <span class="menu-meta">{child.meta}</span>}
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
        )
      )}
    </nav>

    <div class="header-actions">
      <div class="social">
        <a href={social.facebook} aria-label="Facebook group" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.3v7A10 10 0 0 0 22 12Z"/></svg>
        </a>
        <a href={social.instagram} aria-label="Instagram" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.2 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.4 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.2 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1 .4-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.2-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c.1-1.2.2-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1-.4 2.2-.4C8.4 2.2 8.8 2.2 12 2.2Zm0 3.2A6.6 6.6 0 1 0 18.6 12 6.6 6.6 0 0 0 12 5.4Zm0 10.9A4.3 4.3 0 1 1 16.3 12 4.3 4.3 0 0 1 12 16.3Zm6.9-11.1a1.5 1.5 0 1 1-1.5-1.5 1.5 1.5 0 0 1 1.5 1.5Z"/></svg>
        </a>
      </div>
      <a class="btn-shop" href="/shop/">Shop</a>
      <a class="btn-donate" href="/donate/">Donate</a>
    </div>
  </div>
</header>
