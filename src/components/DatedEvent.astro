---
/**
 * The page body for one dated event — a dine out night, or a one-off.
 *
 * Shared by both routes so the two never drift: a night lives under its series
 * at /events/dine-out/<url>/ and a one-off sits at /events/<url>/, but they are
 * the same thing and read the same way.
 *
 * Unlike an annual event's page, this one never hides a date for being in the
 * past. The date is what the page IS — suppressing it on a night that has
 * already happened would leave a page about nothing.
 */
import { fullDate, imageUrl, orgTag } from '../lib/sanity';
import type { DatedEvent } from '../lib/sanity';

interface Props {
  event: DatedEvent;
  back: { href: string; label: string };
}

const { event, back } = Astro.props;

const tag = event.seriesOrg ? orgTag(event.seriesOrg) : null;
/* Width only. Passing a height crops at the CDN, and these are portrait
   flyers — this is the page where the whole flyer matters most. */
const photo = imageUrl(event.photo, 900);
const past = (event.date ?? '') < new Date().toISOString().slice(0, 10);
---

<section>
  <div class="wrap">
    <div class="sec-head page-head">
      <div>
        <p class="eyebrow">
          {tag && <span>{tag.label}</span>}
          {tag && event.seriesTitle && <span> &middot; </span>}
          {event.seriesTitle && <span>{event.seriesTitle}</span>}
          {!tag && !event.seriesTitle && <span>Event</span>}
        </p>
        <h2>{event.title}</h2>
        {/* Whitespace before an expression is trimmed at a line break, so the
            date and the location are assembled as elements rather than as
            text with an interpolation after it. */}
        <p class="de-when">
          <strong>{fullDate(event.date!)}</strong>
          {event.where && <span> &middot; {event.where}</span>}
        </p>
      </div>
    </div>

    {past && (
      <p class="de-past">This one has already happened &mdash; it is kept here so old links keep working.</p>
    )}

    {photo && (
      <div class="de-photo">
        <img src={photo} alt={event.title ?? 'Event photo'} />
      </div>
    )}

    {event.summary && <div class="event-body-copy"><p>{event.summary}</p></div>}

    {event.link && (
      <div class="cs-actions mt">
        <a class="btn btn-lg btn-primary" href={event.link} target="_blank" rel="noopener noreferrer">
          Details and directions
        </a>
      </div>
    )}

    <p class="de-back"><a href={back.href}>&larr; {back.label}</a></p>
  </div>
</section>
